# ──────────────────────────────────────────────────────────────────────────────
# dive-nerd environment variables
#
# Copy this file to `.env.local` at the repo root and fill in real values:
#     cp .env.example .env.local
#
# The root `pnpm dev` script loads `.env.local` via `dotenv-cli` and forwards
# the variables into every workspace package through Turborepo. Do NOT commit
# `.env.local` — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth0 (@auth0/nextjs-auth0) ───────────────────────────────────────────────
# Long random string used to encrypt the session cookie.
# Generate one with:   openssl rand -hex 32
AUTH0_SECRET=

# Base URL of this app (no trailing slash). Use the deployed URL in production.
APP_BASE_URL=http://localhost:3000

# Your Auth0 tenant domain — hostname only, no scheme (e.g. dev-abc123.us.auth0.com)
AUTH0_DOMAIN=

# From Auth0 Dashboard → Applications → <your app> → Settings
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
