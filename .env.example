# ──────────────────────────────────────────────────────────────────────────────
# dive-nerd environment variables
#
# Copy this file to `.env.local` at the repo root and fill in real values:
#     cp .env.example .env.local
#
# The root `pnpm dev` script loads `.env.local` via `dotenv-cli` and forwards
# the variables into every workspace package through Turborepo. Do NOT commit
# `.env.local` — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth0 (@auth0/nextjs-auth0) ───────────────────────────────────────────────
# Long random string used to encrypt the session cookie.
# Generate one with:   openssl rand -hex 32
AUTH0_SECRET=

# Base URL of this app (no trailing slash). Use the deployed URL in production.
AUTH0_BASE_URL=http://localhost:3000

# Your Auth0 tenant URL, e.g. https://dev-abc123.us.auth0.com
AUTH0_ISSUER_BASE_URL=

# From Auth0 Dashboard → Applications → <your app> → Settings
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ── Database (Prisma / Postgres) ──────────────────────────────────────────────
# Vercel Postgres-style URLs. If you use Vercel Postgres you can pull these
# automatically with:   vercel env pull .env.local
# Otherwise point them at any Postgres instance (e.g. local Docker, Supabase,
# Neon). `POSTGRES_PRISMA_URL` should use the pooled connection, while
# `POSTGRES_URL_NON_POOLING` is used by Prisma for migrations.
POSTGRES_DATABASE=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
